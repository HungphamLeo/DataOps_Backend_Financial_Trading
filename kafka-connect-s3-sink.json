# Kafka Connect — S3 Sink Connector Configuration
# ================================================
# LEARN: Kafka Connect là framework để connect Kafka với external systems
#        Không cần viết consumer code — chỉ cần configure connector
#
# Flow: Kafka Topics → Kafka Connect S3 Sink → MinIO (S3-compatible) → Parquet files
#
# Connector modes:
#   Source Connector: External System → Kafka
#   Sink Connector:   Kafka → External System (đây là loại này)
#
# Deploy: POST request đến Kafka Connect REST API (port 8083)
# curl -X POST http://localhost:8083/connectors \
#      -H "Content-Type: application/json" \
#      -d @kafka-connect-s3-sink.json

{
  "name": "binance-vps-s3-sink",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "tasks.max": "4",

    # Topics để sink — tất cả raw data streams
    "topics": "binance.trade.ticks,binance.orderbook.snapshot,binance.liquidation.events,vps.market.snapshot",

    # MinIO S3-compatible storage
    "s3.region": "us-east-1",
    "s3.bucket.name": "binance-datalake",
    "s3.part.size": "67108864",
    "store.url": "${file:/opt/kafka/secrets/minio.properties:endpoint}",
    "s3.credentials.provider.class": "com.amazonaws.auth.DefaultAWSCredentialsProviderChain",
    "s3.path.style.access.enabled": "true",

    # Storage format: Parquet với Snappy compression
    # LEARN: Parquet = columnar format, rất hiệu quả cho analytical queries
    #        Columnar: đọc 1 column không cần đọc toàn bộ row
    "format.class": "io.confluent.connect.s3.format.parquet.ParquetFormat",
    "parquet.codec": "snappy",

    # Schema Registry để decode Avro messages
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",

    # Partitioning strategy: time-based
    # Output path: s3://bucket/topics/{topic}/year={}/month={}/day={}/{files}
    # LEARN: TimeBasedPartitioner tạo Hive-compatible partition layout
    #        Spark và DuckDB có thể prune partitions khi query → nhanh hơn nhiều
    "partitioner.class": "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
    "path.format": "'year'=YYYY/'month'=MM/'day'=dd/'hour'=HH",
    "partition.duration.ms": "3600000",
    "locale": "en_US",
    "timezone": "UTC",
    "timestamp.extractor": "RecordField",
    "timestamp.field": "tsMs",

    # File rotation: tạo file mới sau 1 giờ hoặc 100MB
    # LEARN: Quá nhỏ → small file problem, quá lớn → memory pressure khi đọc
    "rotate.interval.ms": "3600000",
    "rotate.schedule.interval.ms": "3600000",
    "flush.size": "100000",

    # Storage topics (Kafka Connect internal state)
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "topics.dir": "topics",

    # Error handling: route failed messages to DLQ topic
    # LEARN: errors.tolerance = "all" + DLQ = không bao giờ block connector vì bad data
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "connect.dlq",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",

    # Schema evolution: FORWARD_TRANSITIVE = producer có thể thêm fields
    "schema.compatibility": "BACKWARD"
  }
}
