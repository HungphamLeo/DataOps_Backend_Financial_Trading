{
  "type": "record",
  "name": "OKXLiquidationEvent",
  "namespace": "com.okx.vps.events",
  "doc": "Forced liquidation event from OKX. Occurs when a position's margin falls below maintenance margin. High liquidation volume = high market stress signal.",
  "fields": [
    {
      "name": "instId",
      "type": "string",
      "doc": "Instrument ID, e.g. BTC-USDT-SWAP"
    },
    {
      "name": "instType",
      "type": "string",
      "doc": "Instrument type: FUTURES, SWAP"
    },
    {
      "name": "totalLoss",
      "type": "double",
      "doc": "Total loss amount in USD"
    },
    {
      "name": "bkLoss",
      "type": "double",
      "doc": "Bankruptcy loss (amount exchange absorbs beyond insurance fund)"
    },
    {
      "name": "side",
      "type": "string",
      "doc": "Liquidated position side: buy=long was liquidated, sell=short was liquidated"
    },
    {
      "name": "size",
      "type": "double",
      "doc": "Liquidated position size in contracts"
    },
    {
      "name": "price",
      "type": "double",
      "doc": "Liquidation price"
    },
    {
      "name": "tsMs",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Liquidation timestamp from OKX"
    },
    {
      "name": "producedAtMs",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Kafka producer timestamp"
    }
  ]
}
