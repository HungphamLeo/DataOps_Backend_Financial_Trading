# =============================================================================
# DataOps Backend Financial Trading — Unified Environment Configuration
# =============================================================================
#
# SECURITY RULES:
#   OK Copy this to .env and fill in real values
#   OK Add .env to .gitignore (NEVER commit .env)
#   OK Use strong secrets in production (32+ chars, random)
#   NO NEVER hardcode secrets in source code
#   NO NEVER log secrets (even partial)
#
# SCOPE: File nay la nguon duy nhat cho tat ca env vars cua toan bo stack:
#   - dataops_backend_api   (Go REST API)
#   - dataops_stream_producer (Go Streaming Producer)
#   - dataops_batch_api     (Python Delta Lake Pipeline)
#   - infra_dataops_finance_trading (Docker Compose)
#
# USAGE:
#   cp .env.example .env
#   # Dien gia tri thuc vao .env, sau do:
#   docker compose --env-file ../.env -f infra_dataops_finance_trading/docker-compose.yml up -d
#   # Hoac tung service:
#   source .env && go run . (Go), python main.py (Python)
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
# "dev" | "prod" -- dung boi Go services (MODE) va Python pipeline
MODE=dev
LOG_LEVEL=INFO

# --- Binance Exchange ---------------------------------------------------------
# WebSocket public URL -- KHONG can API key cho market data streams
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# Trading pairs can stream (dung boi dataops_stream_producer)
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# REST API base URL (dung boi dataops_batch_api)
BINANCE_REST_URL=https://api.binance.com/api/v3
# SENSITIVE: Chi can cho private endpoints (account, orders) -- de trong neu chi dung market data
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- TCBS iFlash Open API (Vietnam Stock Market) ------------------------------
# Reference: docs/openapi-v1.0.0.json
# Auth flow: POST /gaia/v1/oauth2/openapi/token (apiKey + Smart OTP -> JWT Bearer)
# Note: Smart OTP (~30s TTL) lay tu TCInvest app -- khong the auto-refresh
TCBS_BASE_URL=https://openapi.tcbs.com.vn
# SENSITIVE: TCBS API key tu TCInvest app developer portal
TCBS_API_KEY=
# SENSITIVE: JWT Bearer token -- lay sau khi authenticate voi apiKey + Smart OTP
# Generate: POST /gaia/v1/oauth2/openapi/token  {"apiKey":"...","otp":"..."}
TCBS_JWT_TOKEN=
# Danh sach ma CK can stream BSA + intraday ticks (dataops_stream_producer)
TCBS_SYMBOLS=VCB,VHM,TCB,VIC,HPG,MSN,VNM,MBB,CTG,BID
# Index baskets can poll market snapshot: HOSE|VN30|HNX|VN100 ...
TCBS_INDEXES=HOSE,VN30,HNX
# BSA investor type: sheep|wolf|shark|all
TCBS_BSA_INVESTOR_TYPE=all
# So trang toi da khi lay intraday tick history moi ma
TCBS_INTRADAY_MAX_PAGES=5
# Timeout (giay) va so lan retry khi goi TCBS API
TCBS_TIMEOUT=15
TCBS_RETRY=3

# --- Kafka KRaft Cluster ------------------------------------------------------
# Go services dung KAFKA_URL (single broker hoac comma-separated)
KAFKA_URL=localhost:9092
# Python batch_api dung KAFKA_BROKERS
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
# Confluent Schema Registry -- Avro serialization
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Redis Cache --------------------------------------------------------------
# Go services (backend_api, stream_producer)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB_0=0

# --- MySQL (User accounts, accounting, indicators) ----------------------------
# QUAN TRONG: backend_api doc MYSQL_DNS (full DSN), khong doc tung field rieng
# Format: user:password@tcp(host:port)/dbname?parseTime=true
MYSQL_DNS=root:root123@tcp(localhost:3306)/binance_analytics?parseTime=true

# --- InfluxDB v2 (Time-series market data) ------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=binance-vps-platform
INFLUXDB_BUCKET=market-data
# SENSITIVE: InfluxDB API token
# Generate: InfluxDB UI -> Data -> API Tokens -> Generate Token
INFLUXDB_TOKEN=

# --- MinIO / S3-compatible (Delta Lake storage) -------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=binance-datalake
# S3 region -- dung us-east-1 cho MinIO local
AWS_REGION=us-east-1

# --- JWT Authentication (dataops_backend_api) ---------------------------------
# SENSITIVE: Phai la chuoi ngau nhien >= 32 ky tu
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access token TTL (gio)
JWT_LIFESPAN_HOURS=24
# Refresh token TTL (gio): 168 = 7 ngay
JWT_REFRESH_LIFESPAN_HOURS=168

# --- Web / API Server ---------------------------------------------------------
WEB_URL=http://localhost:3000
APP_PORT=8080

# --- Spark (dataops_batch_api) ------------------------------------------------
# Local dev: local[*]  |  Docker: spark://spark-master:7077
SPARK_MASTER=local[*]

# =============================================================================
# PRODUCTION OVERRIDES -- Bo comment khi deploy len staging/production
# =============================================================================
# MODE=prod
# APP_ENV=production
# KAFKA_URL=kafka1:9092,kafka2:9092,kafka3:9092
# KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092
# MYSQL_DNS=appuser:STRONG_PASSWORD@tcp(mysql-prod:3306)/binance_analytics?parseTime=true
# INFLUXDB_URL=https://influxdb.internal:8086
# MINIO_ENDPOINT=https://s3.amazonaws.com
# REDIS_ADDRESS=redis-prod:6379
