{
  "type": "record",
  "name": "TCBSMarketEvent",
  "namespace": "com.tcbs.market.events",
  "doc": "Full market snapshot từ TCBS tickerCommons API — orderbook 3 cấp, OHLC, foreign room. Reference: openapi-v1.0.0.json /tartarus/v1/tickerCommons",
  "fields": [
    { "name": "symbol",        "type": "string",          "doc": "Mã cổ phiếu, e.g. VCB, VHM" },
    { "name": "exchange",      "type": "string",          "doc": "Tên basket index dùng làm exchange label, e.g. HOSE, VN30, HNX" },
    { "name": "refPrice",      "type": "double",          "doc": "Giá tham chiếu (đóng cửa hôm qua)",  "default": 0.0 },
    { "name": "ceilPrice",     "type": "double",          "doc": "Giá trần",                            "default": 0.0 },
    { "name": "floorPrice",    "type": "double",          "doc": "Giá sàn",                             "default": 0.0 },
    { "name": "matchPrice",    "type": "double",          "doc": "Giá khớp lệnh hiện tại",              "default": 0.0 },
    { "name": "matchQty",      "type": "double",          "doc": "Khối lượng khớp lệnh",                "default": 0.0 },
    { "name": "bidPrice01",    "type": "double",          "doc": "Giá chào mua 1 (best bid)",           "default": 0.0 },
    { "name": "bidPrice02",    "type": "double",          "doc": "Giá chào mua 2",                      "default": 0.0 },
    { "name": "bidPrice03",    "type": "double",          "doc": "Giá chào mua 3",                      "default": 0.0 },
    { "name": "bidQty01",      "type": "double",          "doc": "Khối lượng chào mua 1",               "default": 0.0 },
    { "name": "bidQty02",      "type": "double",          "doc": "Khối lượng chào mua 2",               "default": 0.0 },
    { "name": "bidQty03",      "type": "double",          "doc": "Khối lượng chào mua 3",               "default": 0.0 },
    { "name": "offerPrice01",  "type": "double",          "doc": "Giá chào bán 1 (best ask)",           "default": 0.0 },
    { "name": "offerPrice02",  "type": "double",          "doc": "Giá chào bán 2",                      "default": 0.0 },
    { "name": "offerPrice03",  "type": "double",          "doc": "Giá chào bán 3",                      "default": 0.0 },
    { "name": "offerQty01",    "type": "double",          "doc": "Khối lượng chào bán 1",               "default": 0.0 },
    { "name": "offerQty02",    "type": "double",          "doc": "Khối lượng chào bán 2",               "default": 0.0 },
    { "name": "offerQty03",    "type": "double",          "doc": "Khối lượng chào bán 3",               "default": 0.0 },
    { "name": "open",          "type": "double",          "doc": "Giá mở cửa phiên",                   "default": 0.0 },
    { "name": "high",          "type": "double",          "doc": "Giá cao nhất phiên",                  "default": 0.0 },
    { "name": "low",           "type": "double",          "doc": "Giá thấp nhất phiên",                 "default": 0.0 },
    { "name": "avg",           "type": "double",          "doc": "Giá trung bình phiên",                "default": 0.0 },
    { "name": "totalVol",      "type": "double",          "doc": "Tổng khối lượng giao dịch",           "default": 0.0 },
    { "name": "totalVal",      "type": "double",          "doc": "Tổng giá trị giao dịch (VND)",        "default": 0.0 },
    { "name": "buyForeignQty", "type": "double",          "doc": "Khối lượng nước ngoài mua",           "default": 0.0 },
    { "name": "sellForeignQty","type": "double",          "doc": "Khối lượng nước ngoài bán",           "default": 0.0 },
    { "name": "room",          "type": "double",          "doc": "Room nước ngoài còn lại (số CP). API trả number, không phải string.", "default": 0.0 },
    { "name": "change",        "type": "double",          "doc": "Thay đổi giá tuyệt đối vs tham chiếu","default": 0.0 },
    { "name": "changePct",     "type": "double",          "doc": "Thay đổi giá phần trăm",             "default": 0.0 },
    { "name": "tradingDate",   "type": "string",          "doc": "Ngày giao dịch dd/MM/yyyy",           "default": "" },
    { "name": "tsMs",          "type": "long",            "doc": "Unix timestamp milliseconds lúc snapshot" },
    { "name": "producedAtMs",  "type": "long",            "doc": "Unix timestamp milliseconds khi producer gửi lên Kafka" }
  ]
}
