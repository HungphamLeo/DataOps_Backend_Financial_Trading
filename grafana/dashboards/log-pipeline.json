  "annotations": {
    "list": []
  },
  "description": "Centralised log view for Python services (dataops_batch_api + dataops_processing) — file-based scrape via Promtail. Filter by service, level, logger name, or job correlation_id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [
        "dataops"
      ],
      "title": "Pipeline Trace",
      "tooltip": "Cross-service trace by trace_id / correlation_id",
      "type": "dashboards",
      "url": "/d/dataops-pipeline-trace"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "## 📋 DataOps Log Pipeline\nFile-based log scrape (Promtail → Loki) for Python services. Jobs: `dataops-batch-api-file`, `dataops-processing-file`. LogQL: `{job=~\"dataops-.*-file\"}`",
        "mode": "markdown"
      },
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (job, level) (rate({job=~\"dataops-.*-file\", level=~\"$log_level\"} [1m]))",
          "legendFormat": "{{job}} / {{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Rate by Service & Level (per minute)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
