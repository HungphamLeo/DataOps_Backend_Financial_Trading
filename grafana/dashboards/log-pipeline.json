      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (job) (rate({job=~\"dataops-.*-file\", level=\"ERROR\"} [1m]))",
          "legendFormat": "{{job}} ERROR",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error Rate (per minute)",
      "type": "timeseries"
    },
