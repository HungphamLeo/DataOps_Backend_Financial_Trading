        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"dataops-batch-api-file\", level=~\"$log_level\"} | json | logger=~\"$logger_filter\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
